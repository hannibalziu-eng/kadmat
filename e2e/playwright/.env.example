BASE_URL=http://127.0.0.1:7357
API_BASE=http://127.0.0.1:3000/api

CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASS=secret123
TECHNICIAN_EMAIL=technician@example.com
